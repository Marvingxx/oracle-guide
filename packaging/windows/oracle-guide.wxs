<?xml version="1.0" encoding="utf-8"?>
<!--
  Oracle Brand Guide MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build oracle-guide.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.oracle-guide` owned by
  Oracle Brand Guide, and Oracle Brand Guide offered under "Open with" for IDML (without taking over the user's
  default app for it).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Oracle Brand Guide"
      Manufacturer="Oracle"
      Version="$(var.Version)"
      UpgradeCode="E1EE0C76-B5FD-49DF-8289-DFA99B3BBD05"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Oracle Brand Guide page layout and publishing" Manufacturer="Oracle" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Oracle Brand Guide is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="OracleGuideIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="OracleGuideIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Marvingxx/oracle-guide" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Marvingxx/oracle-guide" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <!-- Shared native setup UI, including install/uninstall completion. -->

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Oracle Brand Guide" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Oracle Brand Guide" Level="1">
      <ComponentGroupRef Id="OracleGuideFiles" />
      <ComponentGroupRef Id="CraftInstallerSettings" />
    </Feature>
    <!-- Shared full UI; app installation policy remains below. -->
    <UIRef Id="CraftInstallerUI" />
  </Package>

  <Fragment>
    <ComponentGroup Id="OracleGuideFiles" Directory="INSTALLFOLDER">
      <Component Id="OracleGuideApp" Guid="A1778AED-F9BB-4A70-8672-60282EA31999">
        <File Id="OracleGuideExe" Source="$(var.BinDir)\oracle-guide.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Oracle Brand Guide"
              Description="Oracle Brand Guide page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="OracleGuideIcon.ico" IconIndex="0" />
        </File>

        <!-- .oracle-guide: Oracle Brand Guide's own format; Oracle Brand Guide is its default app. -->
        <ProgId Id="OracleGuide.Document" Description="Oracle Brand Guide Document" Icon="OracleGuideExe" IconIndex="0">
          <Extension Id="oracle-guide" ContentType="application/x-oracle-guide">
            <Verb Id="open" Command="Open" TargetFile="OracleGuideExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- IDML: offered under "Open with", never forced as the default. -->
        <ProgId Id="OracleGuide.Idml" Description="IDML Document" Icon="OracleGuideExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\OracleGuide.Idml\shell\open\command" Value="&quot;[#OracleGuideExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.idml\OpenWithProgids" Name="OracleGuide.Idml" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "oracle-guide"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-guide.exe" Name="FriendlyAppName" Value="Oracle Brand Guide" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-guide.exe\shell\open\command" Value="&quot;[#OracleGuideExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-guide.exe\SupportedTypes" Name=".oracle-guide" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\oracle-guide.exe\SupportedTypes" Name=".idml" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\oracle-guide.exe" Value="[#OracleGuideExe]" Type="string" />
      </Component>

      <Component Id="OracleGuideCli">
        <File Id="OracleGuideCliExe" Source="$(var.BinDir)\oracle-guide-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
