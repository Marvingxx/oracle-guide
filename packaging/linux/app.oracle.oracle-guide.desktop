[Desktop Entry]
Type=Application
Name=Oracle Brand Guide
GenericName=Page Layout
Comment=Lay out magazines, books and print documents
Exec=oracle-guide %F
TryExec=oracle-guide
Icon=app.oracle.oracle-guide
Terminal=false
